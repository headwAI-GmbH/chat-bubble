# Dockerfile for serving the Chat Bubble widget during E2E tests
FROM node:18-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci

# Copy source code
COPY . .

# Build the chat bubble widget from source, or, if WIDGET_VERSION is set, use
# the published dist-widget of that version from npm instead
ARG WIDGET_VERSION=
RUN if [ -n "$WIDGET_VERSION" ]; then \
      rm -rf dist-widget && \
      npm pack "@headwai/chat-bubble@$WIDGET_VERSION" && \
      tar -xzf headwai-chat-bubble-*.tgz && \
      mv package/dist-widget dist-widget && \
      node -p "require('./package/package.json').version" > widget-version.txt && \
      rm -rf package headwai-chat-bubble-*.tgz; \
    else \
      npm run build && \
      node -p "require('./package.json').version + ' (source)'" > widget-version.txt; \
    fi

# Install a simple HTTP server
RUN npm install -g http-server

# Copy entrypoint script that generates test.html dynamically at startup
COPY e2e/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Expose port 5174
EXPOSE 5174

# Generate test.html at startup (with optional api-key) then serve
CMD ["/entrypoint.sh"]